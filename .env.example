# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase credentials
# DO NOT commit .env.local to version control

# Your Supabase project URL (from Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (from Project Settings > API)
# This key is safe to expose in client-side code (RLS protects your data)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
